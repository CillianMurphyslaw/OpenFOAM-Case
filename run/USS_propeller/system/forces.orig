forces
{
    type          forces;

    libs          (forces);

    writeControl  timeStep;
    timeInterval  1;

    log           yes;

    patches       (propeller);
    rho           rhoInf;     // Indicates incompressible

    log           true;
    rhoInf        999.6;          // Redundant for incompressible

    CofR          (0 0.04465 0.1925);    // Rotation around centre line of propeller
    pitchAxis     (0 1 0);
}


